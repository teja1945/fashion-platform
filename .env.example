# Template environment variables -- COPY ke .env dan isi nilai asli
# JANGAN PERNAH commit file .env yang berisi nilai asli ke git

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname
BACKUP_DATABASE_URL=postgresql://user:password@host:port/dbname

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Redis
REDIS_PASSWORD=

# API Keys tenant
API_KEY=
BRG_DEMO_TENANT_API_KEY=

# Error tracking (Sentry)
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Runtime
NODE_ENV=production
DOTENV_CONFIG_QUIET=true
